aidl_interface {
    name: "vendor.samsung.hardware.biometrics.fingerprint",
    srcs: ["vendor/samsung/hardware/biometrics/fingerprint/*.aidl"],
    stability: "vintf",
    vendor_available: true,
    owner: "samsung",

    backend: {
        java: {
            enabled: true,
            platform_apis: true,
        },
        ndk: {
            enabled: true,
        },
        cpp: {
            enabled: true,
        },
    },
    frozen: false,
}
