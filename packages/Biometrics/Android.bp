android_app {
    name: "SamsungBiometrics",
    srcs: [
        "src/**/*.java",
    ],

    libs: [
        "secinputdev-service",
    ],

    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    privapp_allowlist: "org.lineageos.biometrics.xml",
}
