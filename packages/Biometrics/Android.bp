android_app {
    name: "SamsungBiometrics",
    srcs: [
        "src/**/*.java",
    ],

    static_libs: [
        "vendor.samsung.hardware.sysinput-V2-java",
    ],

    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    privapp_allowlist: "org.lineageos.biometrics.xml",
}
